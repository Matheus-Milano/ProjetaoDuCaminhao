<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="window_entrada_pecas">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Registrar entrada de peças</property>
    <property name="default-width">520</property>
    <property name="default-height">440</property>
    <property name="window-position">center</property>
    <child>
      <object class="GtkBox" id="box_entrada_pecas">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">18</property>
        <property name="margin-left">24</property>
        <property name="margin-right">24</property>
        <property name="margin-top">24</property>
        <property name="margin-bottom">24</property>
        <child>
          <object class="GtkBox">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Nova entrada no estoque</property>
                <property name="halign">start</property>
                <attributes>
                  <attribute name="weight" value="bold"/>
                  <attribute name="scale" value="1.35"/>
                </attributes>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Informe os dados da peça e a quantidade recebida.</property>
                <property name="halign">start</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkGrid" id="grid_entrada_pecas">
            <property name="visible">True</property>
            <property name="row-spacing">14</property>
            <property name="column-spacing">16</property>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Código da peça</property>
                <property name="halign">start</property>
              </object>
              <packing><property name="left-attach">0</property><property name="top-attach">0</property></packing>
            </child>
            <child>
              <object class="GtkEntry" id="txt_codigo_peca">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="placeholder-text" translatable="yes">Ex.: FIL-001</property>
              </object>
              <packing><property name="left-attach">1</property><property name="top-attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Nome da peça</property>
                <property name="halign">start</property>
              </object>
              <packing><property name="left-attach">0</property><property name="top-attach">1</property></packing>
            </child>
            <child>
              <object class="GtkEntry" id="txt_nome_peca">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="placeholder-text" translatable="yes">Ex.: Filtro de óleo</property>
              </object>
              <packing><property name="left-attach">1</property><property name="top-attach">1</property></packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Quantidade recebida</property>
                <property name="halign">start</property>
              </object>
              <packing><property name="left-attach">0</property><property name="top-attach">2</property></packing>
            </child>
            <child>
              <object class="GtkEntry" id="txt_quantidade_entrada">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="input-purpose">digits</property>
                <property name="placeholder-text" translatable="yes">Ex.: 10</property>
              </object>
              <packing><property name="left-attach">1</property><property name="top-attach">2</property></packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Valor unitário (R$)</property>
                <property name="halign">start</property>
              </object>
              <packing><property name="left-attach">0</property><property name="top-attach">3</property></packing>
            </child>
            <child>
              <object class="GtkEntry" id="txt_valor_unitario_peca">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
                <property name="placeholder-text" translatable="yes">Ex.: 89,90</property>
              </object>
              <packing><property name="left-attach">1</property><property name="top-attach">3</property></packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="label" translatable="yes">Os campos de código podem ser usados para identificar peças já cadastradas no estoque.</property>
            <property name="halign">start</property>
            <property name="xalign">0</property>
            <property name="wrap">True</property>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkButtonBox">
            <property name="visible">True</property>
            <property name="layout-style">end</property>
            <property name="spacing">8</property>
            <child>
              <object class="GtkButton" id="btn_cancelar_entrada_peca">
                <property name="label" translatable="yes">Cancelar</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_salvar_entrada_peca">
                <property name="label" translatable="yes">Registrar entrada</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">3</property>
          </packing>
        </child>
      </object>
    </child>
    <child type="titlebar">
      <object class="GtkHeaderBar">
        <property name="visible">True</property>
        <property name="title" translatable="yes">Entrada de peças</property>
        <property name="show-close-button">True</property>
      </object>
    </child>
  </object>
</interface>
